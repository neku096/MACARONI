{
  "name": "macaroni-next-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "next build --webpack",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare upload",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:products": "node scripts/validate-products.mjs",
    "validate:free-poses": "node scripts/validate-free-poses.mjs",
    "validate:top-cards": "node scripts/validate-top-cards.mjs",
    "validate": "npm run validate:products && npm run validate:free-poses && npm run validate:top-cards"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.19.11",
    "next": "16.2.7",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.2",
    "typescript": "5.9.3",
    "wrangler": "4.97.0"
  }
}
